# Backend environment variables. Copy to .env for local development:  cp .env.example .env
# NEVER commit .env (it is in .gitignore). On Render, add these in the service's "Environment" tab.

# --- Database --------------------------------------------------------------
# Local development (docker compose up -d):
DATABASE_URL="postgresql://pavement:pavement@localhost:5433/pavement?schema=public"
DIRECT_URL="postgresql://pavement:pavement@localhost:5433/pavement?schema=public"
# Supabase (Project -> Connect -> "Session pooler"); use it for BOTH on Render:
# DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
# DIRECT_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Auth --------------------------------------------------------------------
# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# --- HTTP --------------------------------------------------------------------
# Comma-separated list of allowed browser origins. "*" wildcards allowed, e.g. Vercel previews:
#   https://your-app.vercel.app,https://your-app-*.vercel.app,http://localhost:3000
CORS_ORIGINS="http://localhost:3000"
# Render sets PORT automatically; locally the API runs on 4000 so Next.js can use 3000.
PORT=4000
